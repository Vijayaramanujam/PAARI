# PAARI - Database and JWT Configuration Example
# Copy this file to '.env' and fill in your details

# MySQL Database setup
DB_HOST=localhost
DB_PORT=3306
DB_NAME=paari_db
DB_USERNAME=root
DB_PASSWORD=rootpassword

# Spring Security & JWT Initialization
JWT_SECRET=jwtSecretKeyForPaariNetworkMustBeAtLeast256BitsToSecureHS256Algorithm1234567890
JWT_EXPIRATION_MS=86400000
